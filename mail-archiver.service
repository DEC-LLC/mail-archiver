[Unit]
Description=Mail Archiver Web UI (HTTPS)
After=network.target

[Service]
Type=simple
ExecStartPre=/opt/mail-archiver/generate-cert.sh /opt/mail-archiver/certs
ExecStart=/usr/bin/gunicorn --config /opt/mail-archiver/gunicorn.conf.py app:app
WorkingDirectory=/opt/mail-archiver
Environment=MAIL_ARCHIVER_SECRET_FILE=/opt/mail-archiver/.secret_key
Environment=MAIL_ARCHIVER_AUTH=pam
Environment=MAIL_ARCHIVER_HTTPS=1
Environment=MAIL_ARCHIVER_CERT_DIR=/opt/mail-archiver/certs

# Override data path: systemctl edit mail-archiver
Environment=MAIL_ARCHIVER_DATA=/var/lib/mail-archiver

User=mail-archiver
Group=mail-archiver
Restart=on-failure
RestartSec=5

# Security hardening
# NOTE: NoNewPrivileges must be FALSE when MAIL_ARCHIVER_AUTH=pam (default).
# pam_unix invokes the setuid helper /usr/sbin/unix_chkpwd (root:shadow, setgid
# bit) to read /etc/shadow — NoNewPrivileges=true blocks setuid execution,
# causing PAM auth to fail silently and users to hit an endless login loop.
# For MAIL_ARCHIVER_AUTH=builtin only, you can safely set this to true via a
# systemd drop-in override.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mail-archiver /opt/mail-archiver/.secret_key /opt/mail-archiver/certs
PrivateTmp=true
# CapabilityBoundingSet intentionally NOT emptied — pam_unix needs
# CAP_DAC_READ_SEARCH via unix_chkpwd's setgid=shadow path.
RestrictNamespaces=true
# RestrictSUIDSGID also disabled — pam_unix helper is setuid/setgid.
# RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
