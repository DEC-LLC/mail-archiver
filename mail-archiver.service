[Unit]
Description=Mail Archiver Web UI (HTTPS)
After=network.target

[Service]
Type=simple
ExecStartPre=/opt/mail-archiver/generate-cert.sh /opt/mail-archiver/certs
# Prefer a real CA-issued certificate over the self-signed fallback.
# Runs after generate-cert.sh so there is always a cert to fall back to,
# and on every start so renewals are picked up. Host-agnostic: set
# MAIL_ARCHIVER_TLS_CERT/_KEY below, or list globs in
# /etc/mail-archiver/tls-sources.conf, for any platform not covered by
# the script's built-in locations.
#Environment=MAIL_ARCHIVER_TLS_CERT=/path/to/fullchain.pem
#Environment=MAIL_ARCHIVER_TLS_KEY=/path/to/privkey.pem
ExecStartPre=-/opt/mail-archiver/install-tls-cert.sh /opt/mail-archiver/certs
ExecStart=/usr/bin/gunicorn --config /opt/mail-archiver/gunicorn.conf.py app:app
# 1.0.17: clear the deferred-restart marker whenever the service starts
# clean (postinst-detected active sync => install left this file behind;
# a manual `systemctl restart` after syncs complete drops it here).
ExecStartPost=-/bin/rm -f /run/mail-archiver/restart-pending
WorkingDirectory=/opt/mail-archiver
Environment=MAIL_ARCHIVER_SECRET_FILE=/opt/mail-archiver/.secret_key
Environment=MAIL_ARCHIVER_AUTH=pam
Environment=MAIL_ARCHIVER_HTTPS=1
Environment=MAIL_ARCHIVER_CERT_DIR=/opt/mail-archiver/certs

# Override data path: systemctl edit mail-archiver
Environment=MAIL_ARCHIVER_DATA=/var/lib/mail-archiver

User=mail-archiver
Group=mail-archiver
# shadow: needed for PAM auth (pam_unix reads /etc/shadow via setgid=shadow
# helper unix_chkpwd). Backup path in case setgid execution is blocked.
SupplementaryGroups=shadow
Restart=on-failure
RestartSec=5

# Security hardening
# NOTE: NoNewPrivileges must be FALSE when MAIL_ARCHIVER_AUTH=pam (default).
# pam_unix invokes the setuid helper /usr/sbin/unix_chkpwd (root:shadow, setgid
# bit) to read /etc/shadow — NoNewPrivileges=true blocks setuid execution,
# causing PAM auth to fail silently and users to hit an endless login loop.
# For MAIL_ARCHIVER_AUTH=builtin only, you can safely set this to true via a
# systemd drop-in override.
# Hardening notes: NAS mode (MAIL_ARCHIVER_AUTH=pam) requires the app to
# reach ARBITRARY user homes to write per-user ~/.mbsyncrc, chown per-user
# config dirs, and drive PAM's setuid+setgid helpers. That inherently means
# broad filesystem + capability access — the hardening below is the MINIMAL
# working set. Do NOT re-add ProtectSystem=strict / ProtectHome=true /
# NoNewPrivileges=true / RestrictSUIDSGID=true without splitting NAS-mode
# and container-mode into two separate service files first.
NoNewPrivileges=false
ProtectSystem=no
ProtectHome=no
ReadWritePaths=/var/lib/mail-archiver /opt/mail-archiver/.secret_key /opt/mail-archiver/certs
PrivateTmp=true
# Capabilities needed for NAS mode:
#   CAP_CHOWN           — _chown_user() on first login (new user config dir)
#   CAP_DAC_OVERRIDE    — write per-user ~/.mbsyncrc into another user's home
#   CAP_DAC_READ_SEARCH — pam_unix reads /etc/shadow (backup path if setgid
#                         via unix_chkpwd is denied by kernel)
#   CAP_FOWNER          — chmod/utime on per-user accounts.json (owned by
#                         PAM user, not by mail-archiver service user)
#   CAP_SETUID/SETGID   — pam_unix account-phase seteuid/setegid
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETUID CAP_SETGID
# SETUID/SETGID must be in Ambient (not just Bounding) so Python's
# subprocess.run(user=..., group=...) can do the setuid before exec.
# Kernel checks CAP_SETUID in CapEff; systemd promotes AmbientCapabilities
# into CapPrm+CapEff+CapInh at drop-to-User= time. Without this, sync
# fails at the subprocess call with PermissionError.
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETUID CAP_SETGID
RestrictNamespaces=true
# RestrictSUIDSGID left disabled — pam_unix helper is setuid/setgid.
# RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
