# Build artifacts — packages are built by packaging/build.sh and published,
# not tracked. Keeping them in git bloats the repo and makes every release
# commit a binary diff.
packaging/*.deb
packaging/*.rpm
packaging/rpmbuild/
packaging/deb/opt/
packaging/deb/etc/
packaging/deb/usr/

# Python
__pycache__/
*.py[cod]

# Release artifacts made by packaging/build.sh and make-source.sh
packaging/dist/
# Live harness: the local configuration names a real server and mailbox.
tools/live-harness/harness.local.conf
