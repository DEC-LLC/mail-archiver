#!/bin/bash
# Token refresh, started by mail-archiver-oauth-refresh.timer as the
# mail-archiver user.
#
# 1.3.4: the refresh needs the same MAIL_ARCHIVER_* settings as
# mail-archiver.service (the data path set by a host drop-in, the secret
# file). Until now the unit had none of them, looked in the default data
# path and failed on every installation that keeps its data elsewhere. Take
# the settings from the main unit, the way mail-archiver-scheduled-sync does.
set -euo pipefail
# The settings of mail-archiver.service, with systemd's quoting undone (a
# value with a space or a quote arrives as the service sees it). Stop when
# they cannot be read: never run with the built-in defaults by accident.
exports=$(/usr/libexec/mail-archiver-env) || {
    echo "$0: cannot take the settings of mail-archiver.service" >&2; exit 1; }
eval "$exports"
cd /opt/mail-archiver
exec python3 oauth2_microsoft.py refresh-expiring
