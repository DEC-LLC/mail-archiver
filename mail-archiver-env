#!/usr/bin/python3
"""Print the MAIL_ARCHIVER_* settings of mail-archiver.service as shell
`export` lines, for the wrappers that must run with the same settings as the
web service (the hourly cron jobs, the token refresh).

    exports=$(/usr/libexec/mail-archiver-env) || exit 1
    eval "$exports"

`systemctl show mail-archiver -p Environment --value` prints each assignment
bare, or in double quotes with backslash escapes when it holds a space or a
character the shell treats specially. This undoes exactly that quoting, so a
value arrives here as the service itself sees it. Exit status 1 (and nothing
on stdout) when the settings cannot be read or understood: a wrapper must
stop then, not carry on with the built-in defaults.

1.3.4. Before it the wrappers split the text on spaces and silently lost
every value that systemd had quoted.
"""
import re
import shlex
import subprocess
import sys

_C_ESCAPES = {'n': '\n', 't': '\t', 'r': '\r', 'a': '\a', 'b': '\b',
              'f': '\f', 'v': '\v', 'e': '\x1b', 's': ' '}
# systemd separates assignments with these four characters only. Python's \s
# and str.isspace() also match no-break space and other Unicode spaces, which
# systemd leaves bare inside a value.
_WS = ' \t\n\r'
_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([^ \t\n\r"]+)', re.S)
_ESCAPE = re.compile(r'\\(?:x([0-9a-fA-F]{2})|([0-7]{3})|(.))', re.S)


def _unescape(match):
    if match.group(1):
        return bytes([int(match.group(1), 16)]).decode('latin-1')
    if match.group(2):
        return bytes([int(match.group(2), 8) & 255]).decode('latin-1')
    return _C_ESCAPES.get(match.group(3), match.group(3))


def parse(text):
    """The assignments in `text`, in order, quoting undone. ValueError on
    text that is not a list of bare or double-quoted words."""
    out, pos, end = [], 0, len(text)
    while pos < end:
        if text[pos] in _WS:
            pos += 1
            continue
        m = _TOKEN.match(text, pos)
        if not m:
            raise ValueError('unexpected text at offset %d' % pos)
        pos = m.end()
        if pos < end and text[pos] not in _WS:
            raise ValueError('unexpected text at offset %d' % pos)
        out.append(m.group(2) if m.group(2) is not None
                   else _ESCAPE.sub(_unescape, m.group(1)))
    return out


def _show(prop):
    return subprocess.run(
        ['systemctl', 'show', 'mail-archiver.service', '-p', prop, '--value'],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True).stdout


def main():
    try:
        load_state = _show('LoadState').decode('ascii', 'replace').strip()
        shown = _show('Environment')
    except OSError as exc:
        sys.stderr.write('mail-archiver-env: cannot read the settings of '
                         'mail-archiver.service: %s\n' % exc)
        return 1
    except subprocess.CalledProcessError as exc:
        sys.stderr.write('mail-archiver-env: cannot read the settings of '
                         'mail-archiver.service: systemctl exit %s: %s\n'
                         % (exc.returncode, (exc.stderr or b'').decode('utf-8', 'replace').strip()))
        return 1
    if load_state != 'loaded':
        # `systemctl show` answers with an empty Environment for a unit it
        # does not know; that must not pass for "no settings".
        sys.stderr.write('mail-archiver-env: mail-archiver.service is not '
                         'loaded (LoadState=%s)\n' % (load_state or 'unknown'))
        return 1
    try:
        settings = parse(shown.decode('utf-8', 'surrogateescape'))
    except ValueError as exc:
        sys.stderr.write('mail-archiver-env: cannot parse the settings of '
                         'mail-archiver.service: %s\n' % exc)
        return 1
    lines = ['export ' + shlex.quote(kv) for kv in settings
             if re.fullmatch(r'MAIL_ARCHIVER_[A-Za-z0-9_]*', kv.split('=', 1)[0])
             and '=' in kv]
    sys.stdout.buffer.write(('\n'.join(lines) + ('\n' if lines else ''))
                            .encode('utf-8', 'surrogateescape'))
    return 0


if __name__ == '__main__':
    sys.exit(main())
